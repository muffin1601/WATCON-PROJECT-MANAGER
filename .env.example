# Supabase — used ONLY for Postgres + Storage (no Supabase Auth in this app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Supabase Postgres connection strings).
# IMPORTANT: if your DB password contains special characters (@ # : / ? % etc.)
# percent-encode them (@ -> %40, # -> %23, ...) — dotenv does not strip inline
# "# comment" text after a value, so keep comments on their own line, never
# appended after the value.
# DATABASE_URL: pooled connection (pgbouncer), used at runtime
DATABASE_URL=
# DIRECT_URL: direct connection, used for migrations
DIRECT_URL=

# OCR provider — see services/ocr/provider.ts for the abstraction.
# "tesseract" is the only implemented provider (free, no key needed, image
# input only). azure / google-vision / aws-textract are stubbed — see
# services/ocr/providers/unimplemented.ts and KNOWN_LIMITATIONS.md.
OCR_PROVIDER=tesseract

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
