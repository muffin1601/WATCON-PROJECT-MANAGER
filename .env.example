# Supabase — used ONLY for Postgres + Storage (no Supabase Auth in this app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Supabase Postgres connection strings).
# IMPORTANT: if your DB password contains special characters (@ # : / ? % etc.)
# percent-encode them (@ -> %40, # -> %23, ...) — dotenv does not strip inline
# "# comment" text after a value, so keep comments on their own line, never
# appended after the value.
# DATABASE_URL: pooled connection (pgbouncer), used at runtime
DATABASE_URL=
# DIRECT_URL: direct connection, used for migrations
DIRECT_URL=

# OCR provider — see services/ocr/provider.ts for the abstraction.
# "tesseract" is the only implemented provider (free, no key needed, image
# input only). azure / google-vision / aws-textract are stubbed — see
# services/ocr/providers/unimplemented.ts and KNOWN_LIMITATIONS.md.
OCR_PROVIDER=tesseract

# ---------------------------------------------------------------------------
# AI document engine (BOQ / Purchase Order / Challan reading)
# ---------------------------------------------------------------------------
# Server-side only — never exposed to the browser. Without it, document upload
# still works; only the automatic reading is disabled.
# Get one at https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Weekly off-site backup -> Google Drive
# ---------------------------------------------------------------------------
# Service-account JSON key, either raw JSON on one line or base64-encoded.
# Base64 is safer in dashboards that mangle the multi-line private key:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Destination folder id — the part after /folders/ in the Drive URL.
# The folder MUST be shared with the service account's client_email as Editor,
# otherwise the upload lands in a Drive nobody can open.
GOOGLE_DRIVE_FOLDER_ID=
# Shared secret guarding /api/cron/backup. That endpoint exports the whole
# database, so it stays disabled until this is set. Generate with:
#   openssl rand -hex 32
BACKUP_CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Full-project deletion
# ---------------------------------------------------------------------------
# Password required to delete an ENTIRE project and all of its data. Verified
# server-side inside the delete request; never sent to the browser. Preferred
# over the Settings screen equivalent because it never touches the database.
# If this is unset, the app uses the hashed password set in Settings, and
# falls back to the legacy challan edit password only so an existing
# deployment is not locked out.
PROJECT_DELETE_PASSWORD=
