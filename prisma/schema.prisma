generator client {
  provider        = "prisma-client-js"
  // relationJoins: lets heavy multi-include reads (project detail /
  // dashboard) run as ONE SQL query with JSON aggregation instead of one
  // round trip per relation table — with the DB in ap-southeast-2, ~10
  // sequential round trips at WAN latency were the bulk of the 5-10s page
  // loads. Opt in per-query via relationLoadStrategy: "join".
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum ProjectStatus {
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum ProjectType {
  SWIMMING_POOL
  WATER_BODY_FOUNTAIN
  TILES_SUPPLY
  TILES_SUPPLY_INSTALL
  FIREPLACE
  SAUNA_STEAM_SPA
  MIXED_SCOPE
}

enum ApprovalMode {
  PURCHASE_ORDER
  QUOTE_EMAIL
  QUOTE_WHATSAPP
  QUOTE_VERBAL
}

enum TermsGst {
  INCLUDED
  EXTRA
}

enum TermsTransport {
  INCLUDED
  EXTRA
}

enum ChallanSource {
  ISSUED_HERE
  ATTACHED_EXTERNAL // e.g. Zoho
}

enum DocumentKind {
  ORDER_COPY // legacy — superseded by PURCHASE_ORDER/BOQ for new uploads, kept for existing rows
  APPROVAL_PROOF
  CHALLAN_COPY
  AMENDMENT_APPROVAL
  PAYMENT_PROOF
  TRANSPORT_BILL
  // General-purpose project document library categories (Document Management System)
  PURCHASE_ORDER
  BOQ
  DRAWING
  INVOICE
  VENDOR_DOCUMENT
  RUNNING_BILL_COPY
  PHOTO
  OTHER
}

enum OcrStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// Stages the AI document engine reports back to the UI progress bar. Kept in
// the exact order the spec lists them so the bar only ever moves forward.
enum ExtractionStage {
  UPLOADING
  READING
  OCR
  EXTRACTING
  VALIDATING
  GENERATING
  COMPLETED
}

enum ExtractionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExtractionJobKind {
  ORDER // BOQ / Purchase Order / approved quotation -> Sales Order draft
  CHALLAN // Delivery challan -> dispatched quantities
  CLASSIFY // Document-type detection only
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum PaymentMode {
  BANK_TRANSFER
  CHEQUE
  UPI
  CASH
  ADJUSTMENT
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PRINT
  IMPORT
  EXPORT
}

// ---------- Core ----------
// Sign-in and per-module permissions live in User/Session at the end of this
// file. Every API route resolves the caller from the session cookie and checks
// its own permission server-side — the client's copy of `perms` only decides
// what to render.

model Vendor {
  id        String   @id @default(uuid())
  name      String
  contact   String? // contact person at the supplier
  gstin     String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  rfqVendors     RfqVendor[]
  rfqResponses   RfqResponse[]

  @@map("vendors")
}

model Setting {
  id                 String   @id @default(uuid())
  key                String   @unique // e.g. "company_profile", "numbering"
  companyName        String   @default("Watcon International")
  address            String   @default("S-36, Okhla Phase 2, New Delhi 110020")
  phone              String   @default("9999969661")
  email              String   @default("info@watcon.net")
  gstin              String?
  gstRatePct         Decimal  @default(18) @db.Decimal(5, 2)
  challanPrefix      String   @default("WC/CH/")
  challanNext        Int      @default(1)
  billPrefix         String   @default("RA-")
  // Quotation numbering. quoteNext is incremented atomically inside the
  // quotation-create transaction (UPDATE ... RETURNING), never read-then-write
  // from the client, so two concurrent requests can never take the same number.
  quotePrefix        String   @default("WI/QTN/")
  quoteNext          Int      @default(1)
  // Rate-inquiry and purchase-order numbering, allocated the same atomic way.
  rfqPrefix          String   @default("WI/RFQ/")
  rfqNext            Int      @default(1)
  poPrefix           String   @default("WI/PO/")
  poNext             Int      @default(1)
  // Soft gate for challan edit/delete (the prototype's APP_PWD prompt) —
  // NOT a security boundary: the app is public/no-auth by design, and this
  // value reaches the client. It only prevents accidental edits.
  appPassword        String   @default("pincode110020")
  // Gate for deleting an ENTIRE project — a genuinely irreversible action, so
  // unlike appPassword above this is a real boundary: only a scrypt hash is
  // stored, it is never selected into any payload that reaches the browser,
  // and verification happens server-side inside the delete request itself.
  // See lib/deletePassword.ts.
  deletePasswordHash String?
  // Anthropic API key for the AI document engine, settable from Settings as in
  // the prototype. WRITE-ONLY: it is never selected into any payload that
  // reaches the browser (unlike the prototype, which kept it in localStorage
  // where any visitor could read it), and never logged. ANTHROPIC_API_KEY in
  // the environment still wins when both are present.
  anthropicApiKey    String?
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

// ---------- Project ----------

model Project {
  id          String        @id @default(uuid())
  name        String
  // Denormalized customer name. Kept as the source of truth for existing rows
  // (the app had no Customer table until now) and always mirrored from
  // customer.name when a project IS linked, so every existing project keeps
  // rendering unchanged whether or not it has been linked yet.
  client      String
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Who introduced the business, and who owns it internally. Rolls up into the
  // Customers > References report.
  refBy       String?
  salesPerson String?
  site        String?
  type        ProjectType
  status      ProjectStatus @default(IN_PROGRESS)

  approvalMode      ApprovalMode @default(PURCHASE_ORDER)
  approvalBasisNote String? // free text for verbal approval

  poNumber String?
  poDate   DateTime?

  termsGst       TermsGst       @default(EXTRA)
  termsTransport TermsTransport @default(EXTRA)
  paymentTerms   String?

  aiGenerated Boolean @default(false) // sales order was drafted via OCR

  // Project Costing tab. Mirrors the prototype's `p.costing` exactly:
  //   { items: { <poItemId>: { rate?, qty? } }, extras: [ { name, amount } ] }
  // Only per-project OVERRIDES live here — the automatic cost rate is derived
  // from the item sheet at read time, so a price change on the sheet flows
  // through instead of being frozen into a stale copy.
  costing Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          PoItem[]
  orders         ProjectOrder[]
  challans       Challan[]
  transports     Transport[]
  bills          Bill[]
  payments       Payment[]
  discounts      Discount[]
  amendments     Amendment[]
  documents      Document[]
  purchaseOrders PurchaseOrder[]
  activityLogs   ActivityLog[]
  extractionJobs ExtractionJob[]

  quotations Quotation[]

  @@index([client])
  @@index([status])
  @@index([customerId])
  @@map("projects")
}

// ---------- Customers & references ----------
// Central customer record. Projects and quotations link here; the Customers
// screen aggregates contract value / goods sent / received / due across both.

model Customer {
  id       String @id @default(uuid())
  name     String
  // Lowercased, whitespace-collapsed name — the uniqueness key, so "ABC Ltd"
  // and "abc  ltd" cannot both exist and silently split one customer's history.
  normName String @unique

  billing  String?
  delivery String?
  phone    String?
  email    String?
  gstin    String?

  refBy       String? // architect / consultant who referred them
  salesPerson String?
  notes       String?

  // Soft delete: customers are referenced by projects and quotations, so they
  // are archived rather than destroyed. Archived customers stay linked and
  // readable, they just drop out of pickers and the default list.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]
  quotations Quotation[]

  @@index([archivedAt])
  @@map("customers")
}

// Sales order line item (called PoItem to match the PO module naming, but
// represents the project's Sales Order line as in the source HTML `p.items`).
model PoItem {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Which additional order (PO/BOQ) this line belongs to; null = the
  // project's original order. Mirrors `it.orderId` in the prototype's tabSO().
  orderId String?
  order   ProjectOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  description String
  // Brand/make of the item — prototype's `it.make` column, also the second
  // half of the Items & Stocks master key (item + make = one stock line).
  make        String  @default("")
  unit        String  @default("Nos")
  qty         Decimal @db.Decimal(14, 3)
  rate        Decimal @db.Decimal(14, 2)
  // When a consolidated BOQ line is bifurcated via splitItemModal(), each
  // sub-item records the ORIGINAL description here ("part of: X" in the UI).
  splitFrom   String?

  sortOrder Int @default(0)

  challanLines       ChallanItem[]
  purchaseOrderLines PoLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([orderId])
  @@map("po_items")
}

// Additional client orders added to a project after creation (prototype's
// `p.orders` from addOrderModal) — the original order lives on Project itself
// (poNumber/poDate/order copy document), additional ones each get a row here
// and their Sales Order items point at them via PoItem.orderId.
model ProjectOrder {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ref  String // order reference / PO number
  date DateTime?

  createdAt DateTime @default(now())

  items     PoItem[]
  documents Document[]

  @@index([projectId])
  @@map("project_orders")
}

// ---------- Purchase Orders (vendor-facing procurement, distinct from the
// client Sales Order above; required by spec's "Purchase Order Module") ----------

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id        String              @id @default(uuid())
  poNumber  String              @unique
  vendorId  String
  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  // Optional: a PO raised from a rate inquiry buys for whichever projects that
  // inquiry covered, which can be several. The per-line projectNames snapshot
  // records what each item is for.
  projectId String?
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rfqId     String?
  rfq       Rfq?                @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  status    PurchaseOrderStatus @default(DRAFT)
  poDate    DateTime
  remarks   String?

  // Supplier terms carried over from their quotation.
  transport     Decimal @default(0) @db.Decimal(14, 2)
  transportGst  Decimal @default(0) @db.Decimal(5, 2)
  transportNote String?
  delivery      String?
  payment       String?
  deliverTo     String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     PoLineItem[]
  documents Document[]

  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@map("purchase_orders")
}

model PoLineItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  linkedItemId    String?
  linkedItem      PoItem?       @relation(fields: [linkedItemId], references: [id], onDelete: SetNull)

  description    String
  make           String  @default("")
  unit           String  @default("Nos")
  qty            Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @db.Decimal(14, 2)
  taxPct         Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)
  remark         String?

  // Which projects this line is being bought for (snapshot from the inquiry).
  projectNames String[] @default([])

  // Quantity received so far. Editing it posts the DIFFERENCE to stock as a
  // purchase entry, so re-saving the same number never double-counts.
  receivedQty Decimal @default(0) @db.Decimal(14, 3)

  sortOrder Int @default(0)

  @@index([purchaseOrderId])
  @@map("po_line_items")
}

// ---------- Challans (delivery challans against the Sales Order) ----------

model Challan {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  no          String
  date        DateTime
  source      ChallanSource @default(ISSUED_HERE)
  vehicle     String?
  driver      String?
  remarks     String?
  manualValue Decimal?      @db.Decimal(14, 2) // used when source = ATTACHED_EXTERNAL without SO linkage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      ChallanItem[]
  extraItems ChallanExtraItem[]
  documents  Document[]
  transports Transport[]

  @@unique([projectId, no])
  @@index([projectId, date])
  @@map("challans")
}

// ---------- Transport bills (prototype's p.transports / tabTransport) ----------
// When project termsTransport = EXTRA these are recoverable from the client
// (added to running bills & site account at actuals); when INCLUDED they are
// recorded as internal cost only.
model Transport {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  transporter String?
  ref         String? // bill / LR number
  vehicle     String?

  challanId String?
  challan   Challan? @relation(fields: [challanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([projectId, date])
  @@map("transports")
}

// Qty dispatched against a Sales Order item (qty = within SO qty, extraQty = beyond BOQ)
model ChallanItem {
  id        String  @id @default(uuid())
  challanId String
  challan   Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  itemId    String
  item      PoItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  qty      Decimal @default(0) @db.Decimal(14, 3)
  extraQty Decimal @default(0) @db.Decimal(14, 3)

  @@index([challanId])
  @@index([itemId])
  @@map("challan_items")
}

// Items dispatched that are not on the Sales Order at all
model ChallanExtraItem {
  id        String  @id @default(uuid())
  challanId String
  challan   Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  description String
  unit        String  @default("Nos")
  qty         Decimal @db.Decimal(14, 3)
  rate        Decimal @default(0) @db.Decimal(14, 2)

  @@index([challanId])
  @@map("challan_extra_items")
}

// ---------- Running Bills ----------

model Bill {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  no   String
  date DateTime // "billed up to" date

  grossBasic      Decimal @db.Decimal(14, 2)
  discountApplied Decimal @default(0) @db.Decimal(14, 2) // discount newly applied in this bill
  discountCum     Decimal @default(0) @db.Decimal(14, 2) // cumulative discount to date
  gst             Decimal @default(0) @db.Decimal(14, 2)
  // Transport at actuals up to the bill date, when termsTransport = EXTRA
  // (prototype's b.transportCum). 0 when transport is included in rates.
  transportCum    Decimal @default(0) @db.Decimal(14, 2)
  grossToDate     Decimal @db.Decimal(14, 2)
  priorBilled     Decimal @db.Decimal(14, 2)
  netPayable      Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  lines BillLine[]

  @@unique([projectId, no])
  @@index([projectId, date])
  @@map("bills")
}

model BillLine {
  id     String @id @default(uuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  description String
  unit        String?
  orderQty    Decimal? @db.Decimal(14, 3)
  cumQty      Decimal? @db.Decimal(14, 3)
  rate        Decimal? @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  isExtra     Boolean  @default(false) // beyond Sales Order

  @@index([billId])
  @@map("bill_lines")
}

// ---------- Payments ----------

model Payment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date           DateTime
  amount         Decimal     @db.Decimal(14, 2)
  mode           PaymentMode
  reference      String?
  recordedByName String? // free-text; no user accounts in this app

  createdAt DateTime @default(now())

  documents Document[]

  @@index([projectId, date])
  @@map("payments")
}

// ---------- Discounts & Amendments ----------

model Discount {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date   DateTime
  amount Decimal  @db.Decimal(14, 2)
  reason String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("discounts")
}

model Amendment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  valueChange Decimal  @db.Decimal(14, 2) // signed: negative = reduction
  // true when the change is ALREADY reflected in the Sales Order item
  // qty/rates (created by "Amend sales order") — excluded from amendTotal()
  // so the value is never counted twice. Prototype's `a.applied` flag.
  applied     Boolean  @default(false)

  createdAt DateTime @default(now())

  documents Document[]

  @@index([projectId])
  @@map("amendments")
}

// ---------- Items & Stocks (prototype's state.itemsMaster / renderStocks) ----------
// One row per item PER MAKE per unit. Rows are auto-created the moment an
// item appears on any project's Sales Order (syncItemsMaster) and can also
// be added manually. Required/delivered/pending are computed across all
// projects at read time; only inward stock entries are stored.
model ItemMaster {
  id      String @id @default(uuid())
  name    String
  make    String @default("")
  unit    String @default("Nos")
  // normalized "name|make|unit" (lowercased, whitespace collapsed) — the
  // prototype's normKey(), enforced unique at the DB level.
  normKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries StockEntry[]

  @@map("item_masters")
}

model StockEntry {
  id           String     @id @default(uuid())
  itemMasterId String
  itemMaster   ItemMaster @relation(fields: [itemMasterId], references: [id], onDelete: Cascade)

  date DateTime
  qty  Decimal  @db.Decimal(14, 3) // negative = outward adjustment
  note String?

  // Entry kind, matching the prototype's stockEntryModal: a purchase also
  // carries rate/vendor/invoice ref, which is what "last purchase price" and
  // the costing sheets read. Adjustments carry none of those.
  // Rows created before this existed default to ADJUST_IN, deliberately: they
  // have no rate, so treating them as purchases would corrupt the last-purchase
  // price used for costing.
  type   StockEntryType @default(ADJUST_IN)
  rate   Decimal?       @db.Decimal(14, 2)
  vendor String?
  ref    String? // invoice / PO reference

  createdAt DateTime @default(now())

  @@index([itemMasterId, date])
  @@map("stock_entries")
}

enum StockEntryType {
  PURCHASE
  ADJUST_IN
  ADJUST_OUT
}

// ---------- Documents (Supabase Storage metadata) & OCR ----------

model Document {
  id   String       @id @default(uuid())
  kind DocumentKind

  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  challanId       String?
  challan         Challan?       @relation(fields: [challanId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amendmentId     String?
  amendment       Amendment?     @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  transportId     String?
  transport       Transport?     @relation(fields: [transportId], references: [id], onDelete: Cascade)
  projectOrderId  String?
  projectOrder    ProjectOrder?  @relation(fields: [projectOrderId], references: [id], onDelete: Cascade)

  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String // Supabase Storage object path
  bucket      String  @default("watcon-documents")
  checksum    String? // SHA-256 of file contents — duplicate detection

  notes String?

  // Version history: the first upload of a document is its own root
  // (rootDocumentId = null, versionNumber = 1). Re-uploading a replacement
  // creates a new Document row pointing rootDocumentId at the original,
  // with versionNumber incremented — this keeps every version as a full,
  // independent row (own storage object, own extracted text) rather than a
  // mutable in-place overwrite, so nothing is ever lost.
  rootDocumentId String?
  rootDocument   Document?  @relation("DocumentVersions", fields: [rootDocumentId], references: [id], onDelete: Cascade)
  versions       Document[] @relation("DocumentVersions")
  versionNumber  Int        @default(1)

  uploadedAt DateTime @default(now())

  ocrResult      OcrResult?
  texts          DocumentText[]
  extractionJobs ExtractionJob[]

  @@index([projectId])
  @@index([challanId])
  @@index([rootDocumentId])
  @@index([checksum])
  @@map("documents")
}

// Raw extracted text per page — deliberately NOT interpreted into
// structured fields (no vendor/PO-number/item guessing). Digital PDFs use
// their embedded text layer; scanned PDFs/images use Tesseract OCR. Exists
// purely so services/searchService.ts can find "which document, which page"
// a phrase appears on — see services/textExtraction/.
model DocumentText {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  pageNumber Int
  rawText    String
  confidence Float? // OCR confidence (0-100), null for digital-text-layer extraction

  createdAt DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_texts")
}

model OcrResult {
  id         String   @id @default(uuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  provider     String // e.g. "anthropic", "google-vision"
  status       OcrStatus @default(PENDING)
  rawResponse  Json?
  extracted    Json? // normalized: { clientName, poNumber, poDate, siteAddress, terms, items[] }
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("ocr_results")
}

// ---------- AI document engine ----------

// One row per document the AI engine reads. The row IS the progress bar:
// the browser polls it for stage/percent instead of holding a long request
// open, so a 50-page BOQ survives a page refresh, a navigation, or a
// serverless function that would otherwise time out mid-extraction.
model ExtractionJob {
  id          String              @id @default(uuid())
  kind        ExtractionJobKind
  status      ExtractionJobStatus @default(QUEUED)
  stage       ExtractionStage     @default(UPLOADING)
  // 0-100, advanced as stages complete. Coarse by design: real per-page
  // progress isn't observable inside a single model call.
  progressPct Int                 @default(0)

  // Optional because the New Project flow extracts a PO *before* a project
  // exists to attach it to — the same reason /api/parse-order is stateless.
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  fileName   String
  mimeType   String
  sizeBytes  Int
  pageCount  Int     @default(0)
  // "pdf-digital" | "pdf-scanned" | "image" | "spreadsheet" — drives whether
  // the UI shows the OCR stage at all.
  sourceKind String?

  detectedType String? // BOQ | PURCHASE_ORDER | CHALLAN | UNKNOWN
  modelUsed    String?

  // Mapped, validated payload the review UI renders. Shape depends on `kind`.
  result Json?
  // Token counts for cost attribution: { inputTokens, outputTokens, cacheReadTokens, ... }
  usage  Json?

  errorMessage String?
  attempts     Int     @default(0)

  // Chunked reading (services/ai/chunking.ts). A long PDF cannot be read in
  // one serverless invocation, so it is sliced into page ranges that are read
  // one per invocation and reassembled here. 0 totalChunks means the document
  // was short enough to read in a single call — the original path.
  totalChunks   Int   @default(0)
  chunksDone    Int   @default(0)
  // Storage paths of the staged page slices, in page order. Removed once the
  // job reaches a terminal state.
  chunkPaths    Json?
  // Per-chunk AiOrderResults accumulated so far, merged when the last chunk
  // lands. Held here rather than in memory because each chunk runs in a
  // different invocation with no shared state.
  chunkResults  Json?
  // Per-chunk retry counts, keyed by chunk index.
  chunkAttempts Json?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  // Bumped as each chunk completes. Distinguishes a job that is slow from one
  // whose invocation was killed, which `createdAt` alone cannot do.
  heartbeatAt DateTime?
  completedAt DateTime?

  @@index([projectId])
  @@index([status, createdAt])
  @@map("extraction_jobs")
}

// Audit trail for the weekly off-site backup. Exists so a silently failing
// backup is visible instead of being discovered when a restore is needed.
model BackupRun {
  id     String       @id @default(uuid())
  status BackupStatus @default(RUNNING)

  fileName     String?
  sizeBytes    Int?
  destination  String  @default("google-drive")
  remoteFileId String? // Google Drive file id, once uploaded
  projectCount Int?
  checksum     String?

  errorMessage String?
  attempts     Int     @default(1)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, startedAt])
  @@map("backup_runs")
}

// ---------- Activity log ----------

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  entity   String // e.g. "Challan", "Bill", "Payment"
  entityId String?
  action   ActivityAction
  summary  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("activity_logs")
}

// ---------- Item Sheet (product catalogue) ----------
// The master product list behind every picker in the app. Distinct from
// ItemMaster above: ItemMaster is a STOCK row (one per item+make+unit, holding
// physical stock movements), whereas CatalogItem is the PRODUCT definition —
// what we sell, which brands make it, what it lists at, what it costs us, and
// which parts it is assembled from.

model CatalogItem {
  id       String @id @default(uuid())
  name     String
  // Lowercased/collapsed name — unique, so the same product cannot be entered
  // twice under two spellings and split its pricing history.
  normName String @unique

  unit     String  @default("Nos")
  category String?
  hsn      String?
  details  String? // specification text, optionally printed under quote lines

  // Brands that manufacture this item. A quotation line may offer any subset.
  makes String[] @default([])

  // Client-facing pricing. sellPrice is the LIST rate; discountPct is the
  // standard discount, applied as its own line on quotations so the printed
  // document shows list rate and discount separately, as the business does.
  sellPrice   Decimal? @db.Decimal(14, 2)
  discountPct Decimal? @db.Decimal(5, 2)

  // Our buying side, used to derive cost rates for costing sheets:
  // net cost = purchasePrice * (1 - purchaseDiscPct/100).
  purchasePrice   Decimal? @db.Decimal(14, 2)
  purchaseDiscPct Decimal? @db.Decimal(5, 2)

  // Product photo in Supabase Storage (same bucket as documents).
  imagePath String?
  imageMime String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components     CatalogComponent[]
  quotationItems QuotationItem[]

  @@index([category])
  @@index([archivedAt])
  @@map("catalog_items")
}

// Bill of materials for assembly/bundle items: one Jacuzzi = 2 x pump,
// 5 x nozzle. Quantities are PER ONE unit of the parent item.
model CatalogComponent {
  id            String      @id @default(uuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  name String
  make String  @default("")
  unit String  @default("Nos")
  qty  Decimal @db.Decimal(14, 3)

  sortOrder Int @default(0)

  @@index([catalogItemId])
  @@map("catalog_components")
}

// ---------- Quotations ----------

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ChargeMode {
  INCLUDED
  EXTRA
}

enum InstallBasis {
  PERCENT
  LUMPSUM
  PER_UNIT
}

model Quotation {
  id   String   @id @default(uuid())
  ref  String   @unique // WI/QTN/001 — allocated atomically from Setting.quoteNext
  date DateTime

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Denormalized so a quotation still prints correctly if the customer is
  // later archived or renamed after the document was sent.
  client     String
  billing    String?
  delivery   String?

  title       String // project title
  refBy       String?
  salesPerson String?

  status       QuotationStatus @default(DRAFT)
  validityDays Int             @default(30)

  // Default discount applied to lines that don't carry their own discPct.
  discountPct Decimal @default(0) @db.Decimal(5, 2)

  installMode  ChargeMode   @default(INCLUDED)
  installBasis InstallBasis @default(PERCENT)
  installValue Decimal      @default(0) @db.Decimal(14, 2)

  transportMode   ChargeMode @default(INCLUDED)
  transportAmount Decimal    @default(0) @db.Decimal(14, 2)

  gstMode ChargeMode @default(EXTRA)
  gstPct  Decimal    @default(18) @db.Decimal(5, 2)

  // Optional hard round of the grand total (the prototype's "Rounded to Rs.").
  roundTo Decimal? @db.Decimal(14, 2)

  note  String?
  terms String?

  showDetails       Boolean @default(false) // print catalogue spec under each line
  areaTotalsWithGst Boolean @default(false)

  // Ordered area / sub-heading names ("Bathroom A", "Kitchen"). Items carry a
  // matching `section` string; anything blank prints as "Other items".
  sections String[] @default([])

  // Totals are computed server-side on every write (services/quotationTotals.ts)
  // and stored so printed/list figures can never drift from a client that
  // posted tampered numbers — the client's totals are ignored entirely.
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount      Decimal @default(0) @db.Decimal(14, 2)
  installAmount  Decimal @default(0) @db.Decimal(14, 2)
  roundedAmount  Decimal @default(0) @db.Decimal(14, 2)
  gstAmount      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal @default(0) @db.Decimal(14, 2)

  // Quotation Costing sheet. Mirrors the prototype's `q.costing`:
  //   { items: { <quotationItemId>: { rate? } }, installPct, extras: [ { name, amount } ] }
  costing Json?

  // Set when "Convert to project" succeeds; blocks a second conversion.
  convertedProjectId String?
  convertedProject   Project?  @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuotationItem[]

  @@index([customerId])
  @@index([status])
  @@index([date])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  // Soft link to the catalogue. SetNull so archiving a product never destroys
  // a quotation that already quoted it.
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  section     String   @default("")
  description String
  makes       String[] @default([]) // approved makes offered for this line
  unit        String   @default("Nos")
  qty         Decimal  @db.Decimal(14, 3)
  rate        Decimal  @db.Decimal(14, 2) // LIST rate before discount
  // Per-line discount override; null = use the quotation's default discountPct.
  discPct     Decimal? @db.Decimal(5, 2)

  sortOrder Int @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

// ---------- Rate Inquiry (RFQ) ----------
// The prototype's Purchase module: pick projects -> pick items (pending
// delivery, netted against stock) -> send each supplier a form -> import their
// replies -> compare landed rates -> issue one PO per chosen supplier.

enum RfqStatus {
  SENT
  COMPARING
  PO_ISSUED
}

model Rfq {
  id   String    @id @default(uuid())
  no   String    @unique // WI/RFQ/001 — allocated atomically from Setting.rfqNext
  date DateTime
  due  DateTime? // rates required by

  deliverTo String?
  note      String?

  status RfqStatus @default(SENT)

  // Projects this inquiry covers. Plain id list: the projects only scope which
  // pending quantities were offered, they are not a lasting relationship, and
  // a deleted project must not cascade away the purchasing history.
  projectIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines          RfqLine[]
  vendors        RfqVendor[]
  responses      RfqResponse[]
  purchaseOrders PurchaseOrder[]

  @@index([status, date])
  @@map("rfqs")
}

model RfqLine {
  id    String @id @default(uuid())
  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  name     String
  make     String  @default("")
  unit     String  @default("Nos")
  category String?

  // Snapshot of the figures the inquiry was built from, so the sheet still
  // reads correctly later even after stock and dispatches have moved on.
  required Decimal @db.Decimal(14, 3)
  stock    Decimal @default(0) @db.Decimal(14, 3)
  qty      Decimal @db.Decimal(14, 3) // quantity actually being asked for

  projectNames String[] @default([])

  sortOrder Int @default(0)

  offers         RfqOffer[]
  // Supplier chosen for this line in the comparison sheet.
  chosenVendorId String?

  @@index([rfqId])
  @@map("rfq_lines")
}

// Which suppliers this inquiry was sent to.
model RfqVendor {
  id       String @id @default(uuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@map("rfq_vendors")
}

// One supplier's reply: the header terms plus a per-line offer.
model RfqResponse {
  id       String @id @default(uuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  quotedBy String?
  contact  String?
  ref      String?
  validity Int?

  transport     Decimal @default(0) @db.Decimal(14, 2)
  transportGst  Decimal @default(0) @db.Decimal(5, 2)
  transportNote String?

  delivery String?
  payment  String?
  remarks  String?

  // true when keyed in by hand from a phone call / paper quote rather than
  // imported from the supplier's own reply file.
  manual Boolean @default(false)

  filledAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  offers RfqOffer[]

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@map("rfq_responses")
}

model RfqOffer {
  id         String      @id @default(uuid())
  responseId String
  response   RfqResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  lineId     String
  line       RfqLine     @relation(fields: [lineId], references: [id], onDelete: Cascade)

  // null rate = "cannot supply this item", which is different from quoting 0.
  rate   Decimal? @db.Decimal(14, 2)
  gstPct Decimal  @default(0) @db.Decimal(5, 2)
  remark String?

  @@unique([responseId, lineId])
  @@index([lineId])
  @@map("rfq_offers")
}

// ---------- Users, sessions & permissions ----------
// The prototype gained a login screen with per-module View/Create/Amend/Delete
// rights and an Admin panel. Reproduced here, with the differences a real
// server demands: passwords are stored only as a scrypt hash (the prototype
// kept them in plain text in localStorage), and the browser holds an opaque
// session token rather than the user record itself, so permissions cannot be
// edited client-side to grant access.

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String @id @default(uuid())
  name         String
  username     String @unique
  // Lowercased username — sign-in is case-insensitive, as in the prototype.
  normUsername String @unique

  passwordHash String

  role   UserRole @default(USER)
  active Boolean  @default(true)

  // { "<module>": { view?: true, create?: true, amend?: true, delete?: true } }
  // Ignored entirely for ADMIN, who always has every right.
  perms Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@map("users")
}

model Session {
  id        String @id @default(uuid())
  // SHA-256 of the cookie value. Storing the raw token would let anyone with
  // database read access impersonate a signed-in user.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
